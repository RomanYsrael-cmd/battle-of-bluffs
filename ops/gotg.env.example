# Production server template. Copy to /opt/gotg/config/gotg.env and populate
# secrets directly on the server. Never commit the populated file.
SPRING_PROFILES_ACTIVE=prod
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8090

DB_URL=jdbc:postgresql://127.0.0.1:5432/battle_of_bluffs_prod
DB_USERNAME=gotg_app
DB_PASSWORD=
DB_POOL_MIN_IDLE=1
DB_POOL_MAX_SIZE=8
DB_CONNECTION_TIMEOUT_MS=10000

FRONTEND_URL=https://bluffs.romanlms.com
ALLOWED_HOSTS=romanlms.com

MAIL_HOST=mail.spacemail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

SESSION_COOKIE_SECURE=true
SESSION_IDLE_TIMEOUT=30m
SESSION_ABSOLUTE_TIMEOUT=12h

REGISTER_RATE_LIMIT=5
REGISTER_RATE_WINDOW=1h
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW=15m
VERIFICATION_RATE_LIMIT=3
VERIFICATION_RATE_WINDOW=1h
FORGOT_PASSWORD_RATE_LIMIT=5
FORGOT_PASSWORD_RATE_WINDOW=1h
RESET_PASSWORD_RATE_LIMIT=10
RESET_PASSWORD_RATE_WINDOW=15m
CHAT_RATE_LIMIT=5
CHAT_RATE_WINDOW=10s

RANKED_FORMATION_LIMIT=5m
RANKED_INITIAL_CLOCK=15m
RANKED_MOVE_INCREMENT=5s
RANKED_DISCONNECT_GRACE=60s
RANKED_CUMULATIVE_DISCONNECT_LIMIT=120s
