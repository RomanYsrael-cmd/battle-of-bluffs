# DEVELOPMENT ONLY. Production must supply distinct secret values externally.
DB_URL=jdbc:postgresql://localhost:5432/battle_of_bluffs
DB_USERNAME=battle_user
DB_PASSWORD=development_password
POSTGRES_DB=battle_of_bluffs
POSTGRES_USER=battle_user
POSTGRES_PASSWORD=development_password
FRONTEND_URL=http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=no-reply@games-of-the-generals.local
SESSION_COOKIE_SECURE=false
SESSION_IDLE_TIMEOUT=30m
SESSION_ABSOLUTE_TIMEOUT=12h
REGISTER_RATE_LIMIT=5
REGISTER_RATE_WINDOW=1h
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW=15m
VERIFICATION_RATE_LIMIT=3
VERIFICATION_RATE_WINDOW=1h
FORGOT_PASSWORD_RATE_LIMIT=5
FORGOT_PASSWORD_RATE_WINDOW=1h
RESET_PASSWORD_RATE_LIMIT=10
RESET_PASSWORD_RATE_WINDOW=15m
CHAT_RATE_LIMIT=5
CHAT_RATE_WINDOW=10s
MEDIA_TOKEN_RATE_LIMIT=10
MEDIA_TOKEN_RATE_WINDOW=1m
RANKED_FORMATION_LIMIT=5m
RANKED_INITIAL_CLOCK=15m
RANKED_MOVE_INCREMENT=5s
RANKED_DISCONNECT_GRACE=60s
RANKED_CUMULATIVE_DISCONNECT_LIMIT=120s

# PUBLIC PRODUCTION BUILD EXAMPLE (Vercel; these values are not secrets)
VITE_API_BASE_URL=https://romanlms.com/bluffs/api
VITE_WS_URL=wss://romanlms.com/bluffs/ws
VITE_LIVEKIT_URL=

# Production server secrets belong only in /opt/gotg/config/gotg.env.
# See ops/gotg.env.example; never copy development passwords into production.
# Optional LiveKit Cloud media. Keep disabled until all three server-only values are configured.
MEDIA_ENABLED=false
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TOKEN_TTL=5m
MEDIA_POST_MATCH_WINDOW=10m
