# DEVELOPMENT ONLY. Production must supply distinct secret values externally.
DB_URL=jdbc:postgresql://localhost:5432/battle_of_bluffs
DB_USERNAME=battle_user
DB_PASSWORD=development_password
POSTGRES_DB=battle_of_bluffs
POSTGRES_USER=battle_user
POSTGRES_PASSWORD=development_password
FRONTEND_URL=http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=no-reply@games-of-the-generals.local
SESSION_COOKIE_SECURE=false
SESSION_IDLE_TIMEOUT=30m
SESSION_ABSOLUTE_TIMEOUT=12h
REGISTER_RATE_LIMIT=5
REGISTER_RATE_WINDOW=1h
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW=15m
VERIFICATION_RATE_LIMIT=3
VERIFICATION_RATE_WINDOW=1h
FORGOT_PASSWORD_RATE_LIMIT=5
FORGOT_PASSWORD_RATE_WINDOW=1h
RESET_PASSWORD_RATE_LIMIT=10
RESET_PASSWORD_RATE_WINDOW=15m
CHAT_RATE_LIMIT=5
CHAT_RATE_WINDOW=10s
RANKED_FORMATION_LIMIT=5m
RANKED_INITIAL_CLOCK=15m
RANKED_MOVE_INCREMENT=5s
RANKED_DISCONNECT_GRACE=60s
RANKED_CUMULATIVE_DISCONNECT_LIMIT=120s
